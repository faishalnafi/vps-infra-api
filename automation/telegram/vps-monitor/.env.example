# ==============================================================
# Konfigurasi VPS Monitor - Telegram Notification
# Salin file ini menjadi ".env" di folder yang sama, lalu isi nilainya.
# JANGAN commit file ".env" (isi asli) ke git - hanya ".env.example" ini yang boleh.
# ==============================================================

# 1. Buat bot baru lewat @BotFather di Telegram -> kirim /newbot -> ikuti instruksinya
#    -> salin "token" yang diberikan ke sini.
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# 2. Dapatkan chat_id tujuan (akun/grup Telegram Anda):
#    - Cara mudah: chat bot @userinfobot di Telegram, dia balas dengan Chat ID Anda.
#    - Cara manual: kirim pesan apa saja ke bot yang baru dibuat, lalu buka
#      https://api.telegram.org/bot<TOKEN_ANDA>/getUpdates di browser,
#      cari nilai "message":{"chat":{"id": ...}}
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# 3. Label supaya Anda tahu VPS mana yang mengirim notifikasi
#    (berguna kalau punya lebih dari satu VPS memakai bot yang sama).
VPS_LABEL=VPS-Production-01

# 4. Referensi interval heartbeat dalam menit (default: 60 = tiap 1 jam).
#    PENTING: mengubah angka ini SAJA TIDAK otomatis mengubah jadwal eksekusi.
#    Jadwal sesungguhnya diatur di scheduler:
#    - Kalau pakai systemd (rekomendasi): ubah "OnUnitActiveSec" di
#      systemd/vps-heartbeat.timer
#    - Kalau pakai cron: ubah baris jadwal di cron/crontab.sample
#    Nilai di sini murni dokumentasi/pengingat.
INTERVAL_MINUTES=60
