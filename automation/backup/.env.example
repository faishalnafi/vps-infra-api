# ==============================================================
# Konfigurasi VPS Backup Otomatis
# Salin file ini jadi ".env" lalu isi nilainya. JANGAN commit ".env" (isi asli) ke git.
# ==============================================================

# Label VPS ini (dipakai di nama file backup & notifikasi Telegram)
VPS_LABEL=VPS-Production-01

# ---- Tujuan backup (WAJIB) ----
# Remote rclone yang SUDAH dikonfigurasi lewat `rclone config` (lihat README.md bagian
# "Setup rclone" untuk panduan tiap provider: Cloudflare R2 / AWS S3 / GCS / IDCloudHost S3),
# plus bucket + folder tujuan. Contoh:
#   RCLONE_REMOTE_PATH=r2:nama-bucket/backups
#   RCLONE_REMOTE_PATH=s3:nama-bucket/backups/vps-jakarta-01
RCLONE_REMOTE_PATH=r2:nama-bucket/backups

# Berapa hari backup disimpan di storage tujuan sebelum otomatis dihapus.
RETENTION_DAYS=14

# ---- MySQL/MariaDB (opsional - dilewati otomatis kalau tidak terpasang/tidak aktif) ----
# Kosongkan kalau autentikasi root sudah lewat ~/.my.cnf. Isi kalau pakai user backup khusus
# (lihat README.md untuk contoh bikin user backup dengan privilege minimal, bukan root).
MYSQL_BACKUP_USER=
MYSQL_BACKUP_PASSWORD=

# ---- PostgreSQL (opsional) ----
POSTGRES_BACKUP_USER=postgres

# ---- MongoDB (opsional) ----
# Kosongkan untuk pakai default lokal (mongodb://localhost:27017). Isi kalau perlu auth/URI khusus.
MONGODB_URI=

# ---- Docker volumes yang mau di-backup (opsional, pisahkan koma) ----
# HANYA volume yang didaftarkan di sini yang di-backup - bukan otomatis semua volume Docker
# (banyak volume cuma cache/build artifact yang tidak perlu di-backup).
# Contoh: DOCKER_VOLUMES=app_uploads,wordpress_data
DOCKER_VOLUMES=

# ---- Data Nginx Proxy Manager (opsional) ----
# Path BIND-MOUNT NPM di host (bukan path di dalam container) - lihat docker-compose NPM Anda.
NPM_DATA_DIR=
NPM_LETSENCRYPT_DIR=

# ---- Notifikasi Telegram (opsional - boleh pakai bot yang sama dengan automation/telegram/vps-monitor) ----
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
# true = juga kirim notifikasi kalau backup SUKSES. Default false = hanya notif kalau ada yang gagal.
NOTIFY_ON_SUCCESS=false
